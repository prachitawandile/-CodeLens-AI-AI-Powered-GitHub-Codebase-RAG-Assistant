# ==============================================================================
# AI-Powered GitHub Codebase RAG Assistant - Environment Configuration
# ==============================================================================

# LLM Provider Configuration: 'gemini' or 'openai'
LLM_PROVIDER=gemini

# Primary API Key (Can be Google Gemini API key or OpenAI API key based on LLM_PROVIDER)
LLM_API_KEY=your_api_key_here

# Specific API Keys (optional if LLM_API_KEY is supplied)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embedding Model Configuration (Sentence-Transformers model name)
# Default lightweight model for CPU/laptop: all-MiniLM-L6-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage and Directories
CHROMA_DB_PATH=backend/data/chroma_db
REPOS_DIR=backend/data/repos

# Chunking Configuration (line-based)
CHUNK_SIZE=100
CHUNK_OVERLAP=15

# Retrieval Configuration
TOP_K_CHUNKS=5

# Maximum supported file size to index (in Kilobytes)
MAX_FILE_SIZE_KB=300

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000
